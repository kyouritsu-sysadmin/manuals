// Used by the editor and `npm run typecheck`, not the Docusaurus build.
// Keep the Docusaurus 3.10 compiler defaults explicit because its shared
// tsconfig still defines baseUrl, which is deprecated in TypeScript 6.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build", "legacy"]
}
